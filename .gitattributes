# Normalise line endings for ordinary text files.
* text=auto

# Files whose raw-byte SHA-256 is recorded in docs/research/freeze.json or the run manifests.
# Store them byte-for-byte (no line-ending conversion) so the published hashes verify on every platform.
config/research_v2.yaml -text
docs/research/PREREGISTRATION.md -text
docs/research/freeze.json -text
docs/research/holdout_evaluated.json -text
docs/research/results/** -text

# v3 study: files whose SHA-256 is recorded in the run manifests (and, after a freeze, in docs/research/v3/freeze.json).
config/research_v3.yaml -text
docs/research/v3/PREREGISTRATION.md -text
docs/research/v3/results/** -text
